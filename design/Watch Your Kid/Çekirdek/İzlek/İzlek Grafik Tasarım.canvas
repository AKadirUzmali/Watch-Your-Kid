		{"id":"47ec975c42a2691c","type":"text","text":"# **İzlek**","x":-4620,"y":-405,"width":970,"height":380,"color":"1"},
		{"id":"ebf32d991a5e675d","type":"text","text":"## İşlemlerin sistem tarafından verilen özel #id sinin yanıda program da özel bir iş id'si verecek ve bu sayede istendiği durumda direk o id ile işlem sonlandırılabilecek fakat eğer genel bir iş ise #id bilgisi hep 0 olacak bu sayede işlem sadece sonlanınca sona erecek","x":1840,"y":-430,"width":375,"height":430,"color":"4"},
		{"id":"02aac4946be0ae20","type":"text","text":"## İşlemleri tek çekirdekte yığın yapmak yerine diğer çekirdeklere de yaymasını sağlamak","x":1840,"y":-4880,"width":375,"height":430,"color":"4"},
		{"id":"9b59022117c063b6","type":"text","text":"## İşlemlerin tutulduğu bir havuz yapısı olacak, bu havuzdan seçilen işlem istenildiğinde sonlandırılabilecek","x":1840,"y":5120,"width":375,"height":430,"color":"4"},
		{"id":"0f5ae99bbb7fafae","type":"text","text":"### Her işleme işletim sistemi özel bir #id verir zaten fakat yeni bir #id ile istenildiği durumda sonlandırılabilmesini kolaylaştıracağız","x":4435,"y":-1380,"width":250,"height":280,"color":"2"},
		{"id":"31ee96ea5ea444a5","type":"text","text":"### Programın tek çekirdeğe yük bindirmesi gecikme ve iş yükünü arttırır, bunu engellemek amaçlı yapılır","x":4435,"y":-6000,"width":250,"height":280,"color":"2"},
		{"id":"a18531c17b183304","type":"text","text":"### O #id bilgisinde işlem yoksa eğer olmadığına dair bilgi döndürecek ya da eğer #id \"0\" ise genel işlem olduğuna dair bilgi döndürecek ama hiç genel işlem yoksa genel işlem yok diye bilgi döndürecek","x":5315,"y":-720,"width":250,"height":380,"color":"2"},
		{"id":"46786c71d04e77f2","type":"text","text":"### İşlemin çalışıp çalışmadığının bilgisini alır","x":5315,"y":-5500,"width":250,"height":280,"color":"2"},
		{"id":"f299368573f02faf","type":"text","text":"### İşlem oluştuktan sonra havuza eklenir","x":4435,"y":-4540,"width":250,"height":280,"color":"2"},
		{"id":"4cdd8562c0c96300","type":"text","text":"#### int32/int64 ctid (custom thread id)","x":5220,"y":-1840,"width":400,"height":50},
		{"id":"bd17327b31c75487","type":"text","text":"#### (has) ctid (custom thread id)","x":6100,"y":-1182,"width":400,"height":50},
		{"id":"45dcbf8f110e3559","type":"text","text":"#### (has) id (thread id)","x":6100,"y":-1132,"width":400,"height":50},
		{"id":"4394dad4562cd191","type":"text","text":"#### (get) thread_count","x":5220,"y":3700,"width":400,"height":50},
		{"id":"f845f95809af09cf","type":"text","text":"### İşlemlerin kaç tane olduğunun bilgisini veriri","x":4435,"y":4160,"width":250,"height":280,"color":"2"},
		{"id":"8393475fb16e879a","type":"text","text":"#### (get) thread","x":6100,"y":4358,"width":400,"height":50},
		{"id":"456433111bef819e","type":"text","text":"### Yeni işlem havuza eklenir, iş bitince ise havuzdan silinir","x":4435,"y":5760,"width":250,"height":280,"color":"2"},
		{"id":"cb304369dd4bff1a","type":"text","text":"### Havuzdan seçilen işlem durdurulabilir, kapatılabilir ya da başka işlemler yapılabilir","x":5295,"y":4720,"width":250,"height":280,"color":"2"},
		{"id":"2f08cdfa2eca7af5","type":"text","text":"#### (exec) oncrash","x":6100,"y":5958,"width":400,"height":50},
